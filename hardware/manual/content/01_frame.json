    "figures": [
      { "src": "frame_20_SHCS_exploded_cam0_nllz.svg", "style": "object-position: 12% center;" }
    ],
    "notes": [
      {
        "h3": { "en": "Direction convention", "zh": "方向约定" },
        "body": { "en": "Top, bottom, left, and right throughout this manual refer to this view.", "zh": "本手册中的上、下、左、右均以这个视角为准。" },
        "classes": "note overlay sm",
        "style": "right:16mm; top:40mm; width:80mm;"
      },
      {
        "h3": { "en": "Mind the placement", "zh": "注意位置" },
        "body": { "en": "Put the short extrusion with the 4 slide-in T-nuts on top.", "zh": "把带四个滑块螺母的短型材放在顶部。" },
        "classes": "note overlay sm",
        "style": "right:16mm; top:60mm; width:80mm;"
      },
      {
        "h3": { "en": "Counterbores face out", "zh": "沉孔朝外" },
        "body": { "en": "Turn the counterbored ends of the long extrusions outward. Align each counterbore with the end hole of the short extrusion.", "zh": "长型材的沉孔开口朝外。每个沉孔对准短型材端面的孔。" },
        "classes": "note overlay sm",
        "style": "right:16mm; top:90mm; width:80mm;"
      },
      {
        "h3": { "en": "Square before final tightening", "zh": "先校方正，再拧紧" },
        "body": { "en": "1. Drop each M6×20 SHCS through the counterbore into the end hole of the short extrusion. 2. Tighten all 8 until snug. 3. Square the frame on a flat surface. 4. Tighten fully.", "zh": "1. 把每颗 M6×20 圆柱头螺栓穿过长型材沉孔。2. 全部拧入短型材端面螺纹孔，拧到贴合。3. 在平整台面上校正框架方正。4. 全部拧紧。" },
        "classes": "note overlay sm",
        "style": "right:16mm; top:120mm; width:80mm;"
      }
    ],
    "bom": {
      "label": { "en": "Bill of materials", "zh": "物料清单" },
      "rows": [
        { "component": { "en": "SHCS", "zh": "圆柱头螺栓" }, "spec": "M6×20", "qty": "8" }
      ]
    }
  },

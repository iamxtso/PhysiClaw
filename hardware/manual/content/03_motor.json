        { "component": { "en": "Motor", "zh": "电机" }, "spec": { "en": "NEMA 17 stepper, 38 mm height", "zh": "42 步进电机，高度 38 mm" }, "qty": "1" },
        { "component": { "en": "BHCS", "zh": "半圆头螺栓" }, "spec": "M3×6", "qty": "4" },

[
  {
    "type": "opener",
    "page": "idler",
    "secnum": {
      "en": "SECTION 02",
      "zh": "第 02 节"
    },
    "h1": {
      "en": "Idler",
      "zh": "惰轮"
    },
    "lede": {
      "en": "Install one idler assembly at each of the four corners of the frame. All four use smooth idlers. The idlers roll on the flat back of the GT2 belt and turn it around each corner. Every idler mount sits 2 mm clear of the horizontal flat bracket at its corner, so the four corners are symmetric.",
      "zh": "框架四角各装一个惰轮组，全部用光面惰轮。惰轮贴着 GT2 同步带的平背面滚动，让同步带在转角处转向。每个惰轮支座都离转角水平安装的一字连接板 2 mm，四角因此对称。"
    }
  },
  {
    "type": "tall-left",
    "page": "idler_10",
    "head": {
      "title": {
        "en": "IDLER",
        "zh": "惰轮"
      },
      "small": "idler_10"
    },
    "figures": [
      {
        "src": "idler_10_lu_exploded_cam0.svg"
      },
      {
        "src": "idler_10_lu_assembled_cam0.svg"
      }
    ],
    "notes": [
      {
        "h3": {
          "en": "Center hardware first",
          "zh": "先装中间的螺栓螺母"
        },
        "body": {
          "en": "Put the M5 square nut and its M5×10 BHCS into the middle counterbore first. The idler stacks block access to it later.",
          "zh": "先把 M5 四方螺母和 M5×10 半圆头螺栓放进中间的沉孔。装上两侧惰轮后，这个沉孔会被挡住。"
        },
        "classes": "note overlay sm",
        "style": "left:105mm; top:70mm; width:80mm;"
      },
      {
        "h3": {
          "en": "Check the idler",
          "zh": "检查惰轮"
        },
        "body": {
          "en": "After installation, make sure that each idler turns freely.",
          "zh": "装好后确认每个惰轮都能自由转动。"
        },
        "classes": "note overlay sm",
        "style": "left:135mm; top:100mm; width:70mm;"
      },
      {
        "h3": {
          "en": "Flat face toward the screw",
          "zh": "平的一面朝向螺栓"
        },
        "body": {
          "en": "Seat each square nut with its flat face toward the screw.",
          "zh": "四方螺母平的一面朝向螺栓。"
        },
        "classes": "note overlay sm",
        "style": "left:135mm; top:130mm; width:70mm;"
      },
      {
        "h3": {
          "en": "Side nut hard to seat?",
          "zh": "侧面螺母放不进？"
        },
        "body": {
          "en": "If a side square nut does not drop into place, clear the pocket with a small screwdriver or a pin. Prints can leave residue in the pocket.",
          "zh": "如果侧面的四方螺母放不到位，先用小螺丝刀或细针清理方槽。打印件方槽内可能有残留。"
        },
        "classes": "note overlay sm",
        "style": "left:135mm; top:155mm; width:70mm;"
      }
    ],

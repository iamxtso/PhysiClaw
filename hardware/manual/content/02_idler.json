  {
    "type": "tall-left",
    "page": "idler_12",
    "head": {
      "title": {
        "en": "IDLER",
        "zh": "惰轮"
      },
      "small": "idler_12"
    },
    "variant": "hero",
    "figures": [
      {
        "src": "idler_12_lu_exploded_cam1_dgik.svg"
      },
      {
        "src": "idler_12_lu_assembled_cam0_swuy.svg",
        "style": "object-position: 64% center;"
      }
    ],
    "notes": [
      {
        "h3": {
          "en": "Two attachments to the frame",
          "zh": "两处固定到框架"
        },
        "body": {
          "en": "The middle M5 screw catches a slide-in T-nut in the extrusion slot. The flat bracket bridges the idler mount and the frame. On the bracket, the longer M5×12 BHCS threads into the captive square nut of the idler mount. The M5×10 BHCS catches the drop-in T-nut in the frame slot.",
          "zh": "中间的 M5 螺栓拧入型材槽内的滑块螺母。一字连接板连接惰轮支座和框架。连接板上较长的 M5×12 半圆头螺栓拧入惰轮支座的预埋四方螺母。M5×10 半圆头螺栓拧入型材槽内的船形螺母。"
        },
        "classes": "note overlay sm",
        "style": "left:110mm; top:30mm; width:80mm;"
      },
      {
        "h3": {
          "en": "2 mm gap to the corner flat bracket",
          "zh": "与转角一字连接板留 2 mm 间隙"
        },
        "body": {
          "en": "Put the idler mount 2 mm clear of the horizontal flat bracket at the frame corner.",
          "zh": "惰轮支座与框架转角水平安装的一字连接板之间留 2 mm。"
        },
        "classes": "note overlay sm",
        "style": "left:110mm; top:78mm; width:80mm;"
      }
    ],
    "bom": {
      "label": {
        "en": "Bill of materials",
        "zh": "物料清单"

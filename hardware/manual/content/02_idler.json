        { "component": { "en": "Shim", "zh": "垫片" }, "spec": "5×8×0.5", "qty": "3" }
      ]
    }
  },
  {
    "type": "tall-left",
    "page": "idler_12",
    "head": { "title": { "en": "IDLER", "zh": "惰轮" }, "small": "idler_12" },
    "variant": "hero",
    "figures": [
      { "src": "idler_12_lu_exploded_cam1_dgik.svg" },
      { "src": "idler_12_lu_assembled_cam0_swuy.svg", "style": "object-position: 64% center;" }
    ],
    "notes": [
      {
        "h3": { "en": "Two ways to the frame", "zh": "两处固定到框架" },
        "body": { "en": "The block locks to the frame in two places: the middle M5 screw catches a slide-in T-nut in the extrusion slot, and the bracket bridges block and frame. On the bracket, the longer M5×12 BHCS threads into the block's captive square nut; the M5×10 catches the T-nut in the frame slot.", "zh": "支座在两处固定到框架：中间的 M5 螺栓拧入型材槽内的滑块螺母，连接板连接支座和框架。连接板上较长的 M5×12 半圆头螺栓拧进支座的预埋四方螺母，M5×10 拧进型材槽内的船形螺母。" },
        "classes": "note overlay sm",
        "style": "left:110mm; top:30mm; width:80mm;"
      },
      {
        "h3": { "en": "2 mm gap to the corner plate", "zh": "与转角连接板留 2 mm 间隙" },
        "body": { "en": "Position the block so it sits 2 mm clear of the frame-corner joining plate.", "zh": "支座与框架转角连接板之间留 2 mm 间隙。" },
        "classes": "note overlay sm",
        "style": "left:110mm; top:72mm; width:80mm;"
      }
    ],
    "bom": {
      "label": { "en": "Bill of materials", "zh": "物料清单" },
      "rows": [
        { "component": { "en": "Flat bracket", "zh": "一字连接板" }, "spec": "40 × 18 × 4 mm", "qty": "1" },
        { "component": { "en": "BHCS", "zh": "半圆头螺栓" }, "spec": "M5×10", "qty": "1" },
        { "component": { "en": "BHCS", "zh": "半圆头螺栓" }, "spec": "M5×12", "qty": "1" },
        { "component": { "en": "T-nut", "zh": "T 型螺母" }, "spec": { "en": "Drop-In M5", "zh": "船形螺母 M5" }, "qty": "1" }
      ]
    }
  },

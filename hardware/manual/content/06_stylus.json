    "notes": [
      {
        "h3": { "en": "Fit the stylus tip", "zh": "安装触控笔尖" },
        "body": { "en": "The solenoid ships with a nut on its bottom end. Remove that nut, then thread the stylus tip on in its place.", "zh": "电磁铁底端出厂时拧有一颗螺母。拧下后在原位拧上触控笔尖。" },
        "classes": "note overlay sm",
        "style": "left:120mm; top:60mm; width:60mm;"
      },
      {
        "h3": { "en": "Solenoid mount holes", "zh": "电磁铁安装孔" },
        "body": { "en": "Two M3 holes, 15 mm apart.", "zh": "两个 M3 孔，间距 15 mm。" },
        "classes": "note overlay sm",
        "style": "left:120mm; top:105mm; width:60mm;"
      }
    ],
    "bom": {
      "label": { "en": "Bill of materials", "zh": "物料清单" },
      "rows": [
        { "component": { "en": "Solenoid", "zh": "推拉式电磁铁" }, "spec": { "en": "12 V, 2×M3, 15 mm pitch", "zh": "12 V，2×M3，孔距 15 mm" }, "qty": "1" },
        { "component": { "en": "Stylus tip", "zh": "触控笔尖" }, "spec": { "en": "Conductive fabric tip, Ø7 mm", "zh": "导电布头 Ø7 mm" }, "qty": "1" }
      ]

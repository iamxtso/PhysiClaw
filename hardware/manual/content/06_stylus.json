  {
    "type": "tall-left",
    "page": "tapz_11",
    "head": {
      "title": { "en": "TOUCH END", "zh": "触控机构" },
      "small": "tapz_11"
    },
    "variant": "hero",
    "figures": [
      { "src": "tapz_11_solenoid_attach_exploded_cam1_cjmx.svg" },
      { "src": "tapz_11_solenoid_attach_assembled_cam0.svg" }
    ],
    "notes": [
      {
        "h3": { "en": "10 hole pairs for height tuning", "zh": "10 对高度调节孔" },
        "body": { "en": "The mount has 10 pairs of holes, spaced 1 mm apart. Pick a pair now, and you can later raise or lower the stylus in 1 mm steps.", "zh": "支架上有 10 对孔，间距 1 mm。先选一对安装，以后可按 1 mm 步进调高或调低触控笔。" },
        "classes": "note overlay sm",
        "style": "left:50mm; top:20mm; width:80mm;"
      },
      {
        "h3": { "en": "Route the power leads", "zh": "电源线走线" },
        "body": { "en": "As indicated, feed the solenoid's +/− leads into the rectangular hole on the mount side, then run them up and out through the rectangular hole at the top.", "zh": "按图所示，电磁铁的正负极引线从支架侧面的方孔穿入，向上从顶部方孔引出。" },
        "classes": "note overlay sm",
        "style": "left:140mm; top:60mm; width:60mm;"
      },
      {
        "h3": { "en": "Ground the solenoid", "zh": "电磁铁接地" },
        "body": { "en": "Clamp the ground wire's bare copper between the solenoid housing and the mount, then tighten a screw to pin it. This grounds the solenoid. Run the ground wire out through the other rectangular hole below to join the power leads.", "zh": "把接地线的裸铜夹在电磁铁外壳和支架之间，拧上螺栓压紧，电磁铁即接地。接地线从下方另一个方孔穿出，与电源线汇合。" },
        "classes": "note overlay sm",
        "style": "left:140mm; top:110mm; width:60mm;"
      }
    ],
    "bom": {
      "label": { "en": "Bill of materials", "zh": "物料清单" },
      "rows": [
        { "component": { "en": "Solenoid mount", "zh": "电磁铁支架" }, "spec": { "en": "SLS/MJF 3D Print", "zh": "SLS/MJF 3D 打印" }, "qty": "1" },
        { "component": { "en": "BHCS", "zh": "半圆头螺栓" }, "spec": "M3×6", "qty": "2" }
      ]
    }

    "notes": [
      {
        "h3": {
          "en": "Install the stylus tip",
          "zh": "安装触控笔尖"
        },
        "body": {
          "en": "The solenoid ships with a nut on its bottom end. Remove the nut, then thread the stylus tip on where the nut was.",
          "zh": "电磁铁底端出厂时拧有一颗螺母。拧下螺母，在原位拧上触控笔尖。"
        },
        "classes": "note overlay sm",
        "style": "left:120mm; top:60mm; width:60mm;"
      },
      {
        "h3": {
          "en": "Solenoid mount holes",
          "zh": "电磁铁安装孔"
        },
        "body": {
          "en": "Two M3 holes, 15 mm apart.",
          "zh": "两个 M3 孔，间距 15 mm。"
        },
        "classes": "note overlay sm",
        "style": "left:120mm; top:105mm; width:60mm;"
      }
    ],
    "bom": {
      "label": {
        "en": "Bill of materials",
        "zh": "物料清单"
      },
      "rows": [
        {
          "component": {
